+        if let Some(mut file) = self.session.as_ref() {
+            let bytes = serde_json::to_vec(self).map_err(io::Error::other)?;
+            file.rewind()?;
+            file.write_all(&bytes)?;
+            file.set_len(bytes.len() as u64)?;
+        }
+        self.dirty = false;
+        Ok(())
